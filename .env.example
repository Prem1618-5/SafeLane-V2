# ══════════════════════════════════════════════════════════════
# SafeLane v2 — Environment Configuration
# Copy this file to .env and fill in your values.
# In Railway, set these as environment variables in the dashboard.
# ══════════════════════════════════════════════════════════════

# ── GitHub OAuth App (REQUIRED) ───────────────────────────────────────────────
# Create at: https://github.com/settings/developers → "OAuth Apps" → "New OAuth App"
#   Application name:  SafeLane
#   Homepage URL:      https://<your-railway-app>.railway.app
#   Redirect URI:      https://<your-railway-app>.railway.app/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Secrets (REQUIRED — generate these once) ─────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── GitHub Webhook Secret (REQUIRED for production) ──────────────────────────
# Any random string — set the same value in GitHub repo Settings → Webhooks
# python -c "import secrets; print(secrets.token_urlsafe(32))"
GITHUB_WEBHOOK_SECRET=

# ── Frontend & CORS ────────────────────────────────────────────────────────────
# The full URL of your deployed app (used for OAuth redirect + CORS)
FRONTEND_URL=https://<your-railway-app>.railway.app
CORS_ORIGINS=https://<your-railway-app>.railway.app

# ── Database ───────────────────────────────────────────────────────────────────
# Railway PostgreSQL: copy from Railway dashboard → PostgreSQL service → Connect
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite+aiosqlite:///./safelane.db

# ── Azure AI Foundry (RECOMMENDED — UAE North region is best for Middle East) ──
# Portal: https://ai.azure.com → Your project → Deploy models
# Recommended deployments:
#   • Chat:       gpt-4o-mini  (cheapest, fast, good enough for evidence summaries)
#   • Embeddings: text-embedding-3-small (1536-dim, used by Qdrant Incident Memory)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# The name you gave the deployment in Azure AI Foundry (e.g. "gpt-4o-mini")
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# The name you gave the embedding deployment (e.g. "text-embedding-3-small")
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ── Qdrant Vector Store (OPTIONAL — enables semantic Incident Memory) ──────────
# Sign up free at: https://cloud.qdrant.io
# Free tier: 1 cluster, 512MB, no credit card needed
QDRANT_URL=https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=

# ── Observability: OpenTelemetry (OPTIONAL) ───────────────────────────────────
# Grafana Cloud free: https://grafana.com/products/cloud/
# Get OTLP endpoint from: Grafana Cloud → Connections → OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_AUTH_TOKEN=
OTEL_SERVICE_NAME=safelane

# ── Local Development Only ────────────────────────────────────────────────────
# Fallback GitHub PAT when no DB registration exists (local testing only)
GITHUB_TOKEN=
# Set to "true" to use built-in mock incident data instead of Qdrant
INCIDENT_MEMORY_MOCK=false
