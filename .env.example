# ══════════════════════════════════════════════════════════════
# SafeLane v2 — Environment Configuration
# Copy this file to .env and fill in values as needed.
# ══════════════════════════════════════════════════════════════

# ── GitHub OAuth (Required) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Required for Platform ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Required for GitHub webhook verification ──
GITHUB_WEBHOOK_SECRET=

# ── Frontend URL (for OAuth callback redirect) ──
FRONTEND_URL=http://localhost:5173

# ── CORS allowed origins (comma-separated) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Database (default: SQLite for local dev) ──
DATABASE_URL=sqlite+aiosqlite:///./safelane.db

# ── Azure OpenAI (Optional — unlocks richer AI-written explanations) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Azure AI Search (Optional — unlocks real Incident Memory history) ──
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# ── Local Development Fallback ──
# Set this to use a GitHub PAT for the SafeLane orchestrator when no DB registration exists
GITHUB_TOKEN=
